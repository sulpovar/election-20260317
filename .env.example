ANTHROPIC_API_KEY=your_key_here

# Ollama model to run locally (must be pulled: ollama pull llama3.2)
LOCAL_MODEL=llama3.2

# Claude model used when local model escalates
CLOUD_MODEL=claude-opus-4-7

# Ollama server address
OLLAMA_BASE_URL=http://localhost:11434

# Escalate to cloud when local confidence is below this (0.0–1.0)
CONFIDENCE_THRESHOLD=0.7
